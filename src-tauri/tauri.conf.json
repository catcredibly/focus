{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus",
  "version": "0.2.0",
  "identifier": "com.focus.timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Focus",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "maximized": true,
        "fullscreen": false,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
