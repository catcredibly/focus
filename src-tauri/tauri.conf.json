{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus",
  "version": "1.2.0",
  "identifier": "com.focus.timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Focus",
        "width": 1440,
        "height": 900,
        "minWidth": 420,
        "minHeight": 300,
        "maximized": true,
        "fullscreen": false,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "timer",
        "title": "Focus Timer",
        "url": "index.html#/popout",
        "width": 360,
        "height": 170,
        "minWidth": 320,
        "minHeight": 170,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "timer-menu",
        "title": "Focus Timer Menu",
        "url": "index.html#/popout-menu",
        "width": 320,
        "height": 330,
        "minWidth": 280,
        "minHeight": 240,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "timer-tab",
        "title": "Focus Timer Tab",
        "url": "index.html#/auto-hide-tab",
        "width": 18,
        "height": 58,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
